# SkyCast-AI - local development settings.
#
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# NEITHER weather API needs a key. Open-Meteo is open, and api.weather.gov is
# open too. The single value below is not a credential, it is a contact
# address: NWS requires every client to identify itself and a way to reach its
# operator, and answers 403 without one.
#
# It is still kept out of source control and read from a Databricks secret in
# production, because it carries a personal email address. See
# mcp_server/secrets.py.

NWS_USER_AGENT=(SkyCast-AI, you@example.com)

# Where the MCP server listens locally. Databricks Apps sets PORT itself.
PORT=8000
